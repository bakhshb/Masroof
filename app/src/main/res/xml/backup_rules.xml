<?xml version="1.0" encoding="utf-8"?>
<!--
    Disable Android Auto Backup for Masroof. Financial data must stay on-device
    unless a future product feature explicitly opts into an encrypted backup.
-->
<full-backup-content>
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" />
    <exclude domain="external" />
</full-backup-content>
