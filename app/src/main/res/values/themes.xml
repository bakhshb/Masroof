<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose owns the runtime theme; this XML theme keeps the activity
        ActionBar-free with transparent system bars for the Compose shell.
    -->
    <style name="Theme.Masroof" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
