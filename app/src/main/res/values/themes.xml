<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Compose owns the runtime theme; this XML theme only ensures the activity
        starts without an ActionBar and uses a transparent system bar background
        so enableEdgeToEdge() can paint behind the status / nav bars.
    -->
    <style name="Theme.Masroof" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
